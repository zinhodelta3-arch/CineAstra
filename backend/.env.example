NODE_ENV=development

HOST=127.0.0.1
PORT=3001

CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=
PUBLIC_ORIGIN=http://localhost:3001

DOCS_ENABLED=true

# Gere uma chave nova e aleatória; não reutilize a chave publicada anteriormente.
JWT_SECRET=320c2a4afff5ab80f94f1264f3e643a15d6d391affa6cde663a458c515f76e2d6e171700fa0c8916bdc1a0ee376627ac8b239faed6b5b7e533b1565ba789d60c
JWT_ISSUER=cineastra
JWT_AUDIENCE=cineastra-web
JWT_TTL_SECONDS=900

# AES-256-GCM: deve ser uma chave aleatória de 32 bytes codificada em Base64.
TWO_FACTOR_ENCRYPTION_KEY=UV1TXb0xF3N+NqxiJGeDYU+NInkMYv8Z9W0IL3mAUEs=

BCRYPT_COST=12

# Preencha somente quando seu projeto tiver as versões oficiais desses documentos.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# MySQL local
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=root
DB_PASSWORD=1234
DB_NAME=cineastra

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_TIMEOUT_MS=3000

HTTP_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=65536

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
INSTANCE_COUNT=1
RATE_LIMIT_STORE=memory

LOG_QUEUE_LIMIT=200
LOG_SUCCESS_SAMPLE_RATE=0.05

LOG_RETENTION_MODE=event
LOG_PURGE_INTERVAL_MS=900000

# Sem CAPTCHA configurado
CAPTCHA_PROVIDER=unavailable

# Testes específicos do MySQL
RUN_MYSQL_TESTS=false
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=
TEST_DB_CONFIRMED_NON_PRODUCTION=false