# Copie para .env local (ignorado). Nenhum valor secreto fornecido.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=
PUBLIC_ORIGIN=http://localhost:3001
DOCS_ENABLED=true
# Hosts exatos HTTPS permitidos para trailer e origem privada do vídeo. Sem download servidor.
CATALOG_MEDIA_HOSTS=

# Diretório ABSOLUTO privado de staging, fora de webroot, exclusivo do processo.
# Desenvolvimento usa backend/.storage/images. Produção exige valor explícito.
# Staging local fica indisponível com INSTANCE_COUNT > 1.
IMAGE_STAGING_DIR=
JWT_SECRET=
JWT_ISSUER=cineastra
JWT_AUDIENCE=cineastra-web
JWT_TTL_SECONDS=900
# Chave AES-256-GCM separada do JWT, base64 de 32 bytes aleatórios (não fornecida).
TWO_FACTOR_ENCRYPTION_KEY=
BCRYPT_COST=12
# Versões de documentos reais aprovados. Não preencher com exemplo inventado.
TERMS_VERSION=
PRIVACY_VERSION=
# Base legal aprovada pelo responsável por privacidade (não inferida pelo código).
IDENTITY_LEGAL_BASIS=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_TIMEOUT_MS=3000
HTTP_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
INSTANCE_COUNT=1
# memória somente instância única. Multi-instância exige store compartilhado injetado.
RATE_LIMIT_STORE=memory
LOG_QUEUE_LIMIT=200
LOG_SUCCESS_SAMPLE_RATE=0.05
# event: verificar evento/scheduler existentes. worker: expurgo por app, sem evento concorrente.
LOG_RETENTION_MODE=event
LOG_PURGE_INTERVAL_MS=900000
CAPTCHA_PROVIDER=unavailable
# integração MySQL exclusiva e opt-in (não usar DB_NAME da aplicação):
RUN_MYSQL_TESTS=false
# Adicional: cria schema completo SOMENTE em TEST_DB_NAME vazio confirmado.
RUN_IDENTITY_MYSQL_TESTS=false
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=
TEST_DB_CONFIRMED_NON_PRODUCTION=false
